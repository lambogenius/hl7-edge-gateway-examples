# Copy to .env and fill in. .env is ignored by git.

# A license token from https://lambogenius.com/app/licensing. A free developer license is enough:
# the sample messages are test messages (MSH-11 = T).
LAMBOGENIUS_LICENSE=

# The admin console asks for this token (http://localhost:8080). Use any long random string.
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The token the gateway sends to the lab API, and the lab API expects.
LAB_API_TOKEN=sample-lab-api-token

# The gateway image version you loaded with `docker load`.
GATEWAY_VERSION=0.3.0
