flowchart LR
  subgraph H["Hospital network"]
    M["MEDITECH"]:::ext
    subgraph G["HL7 Edge Gateway (Docker)"]
      R1["route lab-results<br/>MLLP :7890<br/>store and forward"]:::gw
      R2["route admissions<br/>MLLP :7891<br/>pass-through"]:::gw
      Q[("embedded queue<br/>on disk")]:::store
      UI["admin console :8080"]:::gw
    end
    OP(["Operator"]):::ext
  end
  API["Lab REST API :8000<br/>/hl7/results<br/>/hl7/admissions"]:::ext
  M -- "ORU^R01 (MLLP)" --> R1
  M -- "ADT^A01 (MLLP)" --> R2
  R1 --> Q
  Q -- "POST, bearer token,<br/>one at a time, in order" --> API
  R2 -- "POST while<br/>MEDITECH waits" --> API
  OP -. "queue, dead letters,<br/>pause, retry" .-> UI

  classDef gw fill:#e8f1fb,stroke:#2563eb,color:#0f172a
  classDef store fill:#fff7e6,stroke:#d97706,color:#0f172a
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#0f172a
  classDef bad fill:#fdecec,stroke:#dc2626,color:#0f172a
  classDef ok fill:#ecfdf3,stroke:#16a34a,color:#0f172a
