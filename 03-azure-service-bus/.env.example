# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The local emulator. These are the emulator's fixed development values, not secrets.
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
EMULATOR_SQL_PASSWORD=Sample03-Emulator-Pw1

GATEWAY_VERSION=0.3.0
