# Copy to .env and fill in (README.md shows where each value comes from). .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Entra ID: your tenant, and the app registration that represents the gateway's API.
ENTRA_TENANT_ID=
GATEWAY_API_APP_ID=

# Entra ID: the care application, a caller with the Hl7.Send role. Only get-token.sh / get-token.ps1
# and the demo use it; the gateway never needs it.
CARE_APP_CLIENT_ID=
CARE_APP_CLIENT_SECRET=

# Salesforce: My Domain URL, the connected app's consumer key, the integration user.
# The private key goes in secrets/salesforce.key.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=

GATEWAY_VERSION=0.3.0
