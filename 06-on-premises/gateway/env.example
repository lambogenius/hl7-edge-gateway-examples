# /etc/hl7-edge-gateway/env on each gateway host (chmod 600, owned by root). Read by systemd.
HL7EDGE_NODE_ID=edge1
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string
HL7EDGE_NATS_PASSWORD=change-me-the-same-on-every-host
LAB_API_URL=https://lab-api.hospital.local/hl7/results
LAB_API_TOKEN=
