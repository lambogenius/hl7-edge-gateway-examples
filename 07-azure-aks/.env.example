# Copy to .env and fill in. .env is ignored by git.
# Azure
AZ_LOCATION=canadacentral
AZ_RESOURCE_GROUP=rg-hl7edge
AZ_AKS_NAME=aks-hl7edge
AZ_ACR_NAME=                     # globally unique, letters and digits only, e.g. contosohl7edge
# The gateway (these become the Kubernetes secret hl7edge-secrets)
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string
NATS_TOKEN=change-me-to-another-long-random-string
LAB_API_URL=https://lab-api.contoso.org/hl7/results
LAB_API_TOKEN=
GATEWAY_VERSION=0.3.0
# The image archive from lambogenius.com/downloads
GATEWAY_IMAGE_ARCHIVE=./hl7-edge-gateway-0.3.0-docker-image-linux-amd64.tar.gz
