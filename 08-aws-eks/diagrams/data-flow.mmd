flowchart TB
  A["MEDITECH sends over Direct Connect or VPN"]:::ext --> B["Internal Network Load Balancer"]:::gw
  B --> C{"Pod ready?<br/>(readiness: GET /ready)"}
  C -- yes --> D["A gateway pod receives the message"]:::gw
  C -- "no" --> D2["Traffic goes to the other pod"]:::gw --> D
  D --> E["Publish to JetStream:<br/>3 replicas in 3 zones"]:::store
  E --> F["ACK AA"]:::ok
  E --> G["One pod at a time delivers each<br/>route's next message, in order"]:::gw
  G --> H{"Lab API answers"}
  H -- "2xx" --> I["Done; next message"]:::ok
  H -- "5xx / down" --> J["Retry with backoff"]:::bad --> G
  G -- "pod deleted mid-delivery" --> K["Another pod delivers it after ack_wait"]:::bad --> G

  classDef gw fill:#e8f1fb,stroke:#2563eb,color:#0f172a
  classDef store fill:#fff7e6,stroke:#d97706,color:#0f172a
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#0f172a
  classDef bad fill:#fdecec,stroke:#dc2626,color:#0f172a
  classDef ok fill:#ecfdf3,stroke:#16a34a,color:#0f172a
