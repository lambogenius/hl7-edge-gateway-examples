# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Your password on the lab's SFTP server (the stand-in on localhost:2222), for looking around with an
# SFTP client. The gateway signs in with its key instead.
LAB_SFTP_PASSWORD=change-me-sftp-password

GATEWAY_VERSION=0.4.0
