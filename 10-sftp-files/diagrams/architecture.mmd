flowchart LR
  subgraph LAB["Northside Lab's SFTP server"]
    OUTB["outbox/*.hl7<br/>(results)"]:::ext
    PROC["outbox/processed<br/>outbox/errors"]:::ext
    INB["inbox/orders_*.hl7"]:::ext
  end
  subgraph G["HL7 Edge Gateway"]
    R1["lab-results-from-sftp<br/>polls every 5 s<br/>store and forward"]:::gw
    R2["orders-to-lab-sftp<br/>MLLP :7890<br/>HL7 batch files"]:::gw
    Q1[("queue")]:::store
    Q2[("queue")]:::store
  end
  subgraph H["Hospital network"]
    M1["MEDITECH<br/>results interface :6661"]:::ext
    M2["MEDITECH<br/>orders"]:::ext
  end
  OUTB -- "SFTP, key sign-in,<br/>host key pinned" --> R1
  R1 -. "move when done" .-> PROC
  R1 --> Q1 -- "MLLP, in file order" --> M1
  M2 -- "ORM^O01" --> R2 --> Q2 -- "SFTP: append to .part,<br/>rename when closed" --> INB

  classDef gw fill:#e8f1fb,stroke:#2563eb,color:#0f172a
  classDef store fill:#fff7e6,stroke:#d97706,color:#0f172a
  classDef ext fill:#f1f5f9,stroke:#64748b,color:#0f172a
  classDef bad fill:#fdecec,stroke:#dc2626,color:#0f172a
  classDef ok fill:#ecfdf3,stroke:#16a34a,color:#0f172a
