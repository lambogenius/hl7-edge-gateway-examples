# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The lab API's bearer token (the stand-in checks it).
LAB_API_TOKEN=change-me-lab-api-token
# The partner clinic's API key for POST /hl7/adt (16 characters or more).
PARTNER_API_KEY=change-me-lakeside-clinic-key
# Your password on the archive's SFTP server (localhost:2222), to look around; the gateway uses its key.
LAB_SFTP_PASSWORD=change-me-sftp-password

GATEWAY_VERSION=0.5.0
