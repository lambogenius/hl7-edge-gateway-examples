# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The patient portal API's bearer token (the stand-in checks it).
PORTAL_API_TOKEN=change-me-portal-api-token
# The salt for the research feed's hashed identifiers: 16 characters or more. Keep it secret, and keep it
# the same, so the same patient always gets the same hash.
RESEARCH_SALT=change-me-research-salt-16+

GATEWAY_VERSION=0.6.0
