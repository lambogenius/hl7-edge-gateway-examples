# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The key registration sends in X-API-Key to ask about eligibility.
REGISTRATION_API_KEY=change-me-registration-key

# Your password for both SFTP accounts (billing and northside, on localhost:2222), for looking around with an
# SFTP client. The gateway signs in with its key instead.
SFTP_PASSWORD=change-me-sftp-password

# The key that encrypts stored claims and remittances. Make one with:
#   docker run --rm lambogenius/hl7-edge-gateway:0.9.2 generate-key
HL7EDGE_STORE_KEY=

# The console user billing-ops. Make the hash of a password (12 characters or more) with:
#   docker run --rm -it lambogenius/hl7-edge-gateway:0.9.2 hash-password
# and paste it in single quotes: it has $ signs in it.
BILLING_OPS_PASSWORD_HASH=''
# Only for demo.sh and demo.ps1, which sign in as billing-ops; leave it empty to skip that step.
BILLING_OPS_PASSWORD=

GATEWAY_VERSION=0.9.2
