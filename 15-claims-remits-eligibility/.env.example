# Copy to .env and fill in. .env is ignored by git.
LAMBOGENIUS_LICENSE=
HL7EDGE_ADMIN_TOKEN=change-me-to-a-long-random-string

# The key registration sends in X-API-Key to ask about eligibility.
REGISTRATION_API_KEY=change-me-registration-key

# Your password for both SFTP accounts (billing and northside, on localhost:2222), for looking around with an
# SFTP client. The gateway signs in with its key instead.
SFTP_PASSWORD=change-me-sftp-password

GATEWAY_VERSION=0.8.0
